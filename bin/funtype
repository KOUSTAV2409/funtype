#!/usr/bin/env bash
# FunType - Instant launcher & window toggle for Unix / Omarchy / Linux / macOS

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$DIR/.." && pwd)"

# 1. Locate binary
if [[ -x "$DIR/funtype-bin" ]]; then
    BIN="$DIR/funtype-bin"
elif [[ -x "$ROOT/target/release/funtype" ]]; then
    BIN="$ROOT/target/release/funtype"
elif command -v funtype-bin >/dev/null 2>&1; then
    BIN="$(command -v funtype-bin)"
elif [[ -f "$ROOT/Cargo.toml" ]]; then
    echo "⚡ FunType binary not found. Compiling release build..."
    (cd "$ROOT" && cargo build --release)
    BIN="$ROOT/target/release/funtype"
else
    echo "❌ Error: Could not locate funtype binary."
    exit 1
fi

# 2. Hyprland fast toggle / focus logic
if command -v hyprctl >/dev/null 2>&1 && [[ -n "$HYPRLAND_INSTANCE_SIGNATURE" ]]; then
    FUNTYPE_PID=$(pgrep -x "funtype-bin" || pgrep -x "funtype" | grep -v "^$$$" | head -n 1)
    if [[ -n "$FUNTYPE_PID" ]]; then
        if [[ "$1" == "--toggle" ]] || [[ "$1" == "-t" ]]; then
            kill -TERM "$FUNTYPE_PID" 2>/dev/null
            exit 0
        else
            hyprctl dispatch focuswindow "title:^(FunType)$" 2>/dev/null
            exit 0
        fi
    fi
fi

# 3. Launch FunType
exec "$BIN" "$@"
